<?xml version="1.0" encoding="utf-8"?>
<!-- Nick 2026-10-23 v1.36: the whole screen scrolls now. The Messages
     history used to sit below the fold on Nick's phone with no way to
     reach it (root didn't scroll).
     Nick 2026-10-23 v1.38: the inner ScrollView is GONE — a ScrollView
     inside a ScrollView steals the touch gesture, so the message box
     never scrolled. The message list now flows in the page scroll. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/selena_light"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Status indicator -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔊 Selena Voice"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="4dp" />

    <!-- Poll status (Nick 2026-10-18 v1.2: shows last queue-poll result) -->
    <TextView
        android:id="@+id/pollStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Poll: not started"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingBottom="2dp" />

    <!-- App version (Nick 2026-10-19 v1.15: so we can verify the installed build) -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="v?"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- In-app updater (Nick 2026-10-22 v1.33): hidden until the version
         check finds a newer APK. Tap downloads it and fires the system
         installer — v1.33 is the last manual install. -->
    <Button
        android:id="@+id/updateBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="⬆️ Update available — tap to install"
        android:textSize="14sp"
        android:visibility="gone"
        android:backgroundTint="#2E7D32" />

    <!-- Playback controls, TWO ROWS (Nick 2026-10-23 v1.36: his pick).
         Four buttons in one row overflowed his screen and squeezed
         Delete off the edge. Row 1: pause/stop. Row 2: newest/delete. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/pauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏸️ Pause"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="⏹️ Stop"
            android:textSize="16sp"
            android:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/skipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏭️ Newest"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/deleteUnlockedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="🗑️ Delete"
            android:textSize="16sp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- v1.50 (2026-10-26): account sign-in + delete-key settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/signInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Sign in"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/deleteKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="🔑 Delete key"
            android:textSize="16sp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Voice mode: Phone (fast, on-device TTS) vs Aria (quality, server MP3) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/voiceModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice: Phone (fast)"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/voiceModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- No auto-readout (Nick 2026-10-19 v1.17): messages show in the log
         but are never played aloud -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No auto-readout"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/noReadoutSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <!-- Output route (Nick 2026-10-19 v1.17): mutually exclusive.
         Neither on = auto (Bluetooth wins when connected). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Output: Bluetooth"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/btSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Output: Phone speaker"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/spkSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <!-- v1.90 (Nick, 2026-11-04): text compose — Nick can originate a
         typed line from the app (coach-mode emulation + latency test).
         POSTs {text} to /api/selena-voice/input; no mic involved. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/composeInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message to Selena"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:textSize="16sp" />

        <Button
            android:id="@+id/composeSendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Send"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/composeStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- v1.91 (Nick, 2026-11-05): coach session streaming (Slice A).
         Start opens a TWO-DOOR step (Nick, 2026-11-05 00:23 EST):
         the disclosure duty is owed to OTHER people, not to Nick.
         "Just me" (solo rehearsal/emulation) starts recording
         immediately, no disclosure step. "With others" opens the
         DISCLOSURE step below (CT all-party consent — the disclosure
         is said BEFORE recording starts, Nick 2026-11-05 00:19 EST),
         and in that mode capture can only begin from the disclosure
         step's explicit confirmation button; no path around it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Coach session"
            android:textSize="16sp"
            android:textColor="@color/selena_dark" />

        <Button
            android:id="@+id/coachSessionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start session"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sessionModePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Who's in this conversation?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/selena_dark"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/sessionSoloButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Just me"
                android:textSize="15sp" />

            <Button
                android:id="@+id/sessionOthersButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="With others"
                android:textSize="15sp" />

            <Button
                android:id="@+id/sessionModeCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cancel"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/disclosurePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Say this first, out loud:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/selena_dark"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/disclosureText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="“My assistant is listening and taking notes for me, so I don’t miss anything.”"
            android:textSize="17sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/disclosureConfirmButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disclosure said — start recording"
                android:textSize="15sp" />

            <Button
                android:id="@+id/disclosureCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cancel"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/coachSessionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- v1.96 (Nick, 2026-11-05): Phase 0 voice panel. NOT an
         enrollment surface — learning is automatic inside sessions
         (solo teaches Voice 1; with-others auto-numbers guests).
         This panel is only: the per-session voice-test toggle, a
         status line read from the one app-global voice store, and
         the housekeeping wipe. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/vpStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voices — no voices stored yet"
            android:textSize="13sp"
            android:textColor="@color/selena_dark"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/voiceTestButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Voice test: off"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/deleteVoicesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Delete voice records"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Message log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:paddingBottom="8dp" />

    <!-- Nick 2026-10-23 v1.38: was a nested ScrollView — the outer one
         stole the touch gesture so the box never scrolled. Now a plain
         list that flows in the page scroll; minHeight keeps the box
         shape when empty. -->
    <LinearLayout
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="280dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>
</ScrollView>
