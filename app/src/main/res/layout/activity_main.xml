<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/selena_light"
    android:padding="16dp">

    <!-- Status indicator -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎙️ Listening for Selena…"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="4dp" />

    <!-- Poll status (Nick 2026-10-18 v1.2: shows last queue-poll result) -->
    <TextView
        android:id="@+id/pollStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Poll: not started"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Always-listening toggle + pulse dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/pulseDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pulse_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Always listening"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/alwaysOnSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Mic button (manual fallback) -->
    <Button
        android:id="@+id/micButton"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:text="🎤"
        android:textSize="40sp"
        android:backgroundTint="@color/selena_purple" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap mic for a one-shot listen (fallback)"
        android:textSize="14sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

    <!-- Message log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:paddingBottom="8dp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for messages…\n"
            android:textSize="14sp"
            android:textColor="@color/selena_dark"
            android:padding="12dp" />
    </ScrollView>

</LinearLayout>
