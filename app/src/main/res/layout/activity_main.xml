<?xml version="1.0" encoding="utf-8"?>
<!-- Nick 2026-10-23 v1.36: the whole screen scrolls now. The Messages
     history used to sit below the fold on Nick's phone with no way to
     reach it (root didn't scroll).
     Nick 2026-10-23 v1.38: the inner ScrollView is GONE — a ScrollView
     inside a ScrollView steals the touch gesture, so the message box
     never scrolled. The message list now flows in the page scroll. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outerScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/selena_light"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Status indicator -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎙️ Listening for Selena…"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="4dp" />

    <!-- Poll status (Nick 2026-10-18 v1.2: shows last queue-poll result) -->
    <TextView
        android:id="@+id/pollStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Poll: not started"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingBottom="2dp" />

    <!-- App version (Nick 2026-10-19 v1.15: so we can verify the installed build) -->
    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="v?"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- In-app updater (Nick 2026-10-22 v1.33): hidden until the version
         check finds a newer APK. Tap downloads it and fires the system
         installer — v1.33 is the last manual install. -->
    <Button
        android:id="@+id/updateBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="⬆️ Update available — tap to install"
        android:textSize="14sp"
        android:visibility="gone"
        android:backgroundTint="#2E7D32" />

    <!-- Always-listening toggle + pulse dot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/pulseDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pulse_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Always listening"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/alwaysOnSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Mic button (manual fallback) -->
    <Button
        android:id="@+id/micButton"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:text="🎤"
        android:textSize="40sp"
        android:backgroundTint="@color/selena_purple" />

    <!-- Playback controls, TWO ROWS (Nick 2026-10-23 v1.36: his pick).
         Four buttons in one row overflowed his screen and squeezed
         Delete off the edge. Row 1: pause/stop. Row 2: newest/delete. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/pauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏸️ Pause"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="⏹️ Stop"
            android:textSize="16sp"
            android:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/skipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏭️ Newest"
            android:textSize="16sp"
            android:visibility="visible" />

        <Button
            android:id="@+id/deleteUnlockedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="🗑️ Delete"
            android:textSize="16sp"
            android:visibility="visible" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap mic for a one-shot listen (fallback)"
        android:textSize="14sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Voice mode: Phone (fast, on-device TTS) vs Aria (quality, server MP3) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/voiceModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice: Phone (fast)"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/voiceModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- No auto-readout (Nick 2026-10-19 v1.17): messages show in the log
         but are never played aloud -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No auto-readout"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/noReadoutSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <!-- Output route (Nick 2026-10-19 v1.17): mutually exclusive.
         Neither on = auto (Bluetooth wins when connected). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Output: Bluetooth"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/btSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Output: Phone speaker"
            android:textSize="16sp"
            android:textColor="@color/selena_dark"
            android:paddingEnd="8dp" />

        <Switch
            android:id="@+id/spkSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <!-- Message log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/selena_dark"
        android:paddingBottom="8dp" />

    <!-- Nick 2026-10-23 v1.38: was a nested ScrollView — the outer one
         stole the touch gesture so the box never scrolled. Now a plain
         list that flows in the page scroll; minHeight keeps the box
         shape when empty. -->
    <LinearLayout
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="280dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>
</ScrollView>
