<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.selena.voice">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v1.72: call-state watch for the phone-call mic mute — state
         only (ringing/offhook/idle), never numbers or call content. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Nick 2026-10-19 v1.16: background operation — the service holds a
         partial wake lock so polling, Realtime, and playback keep running
         with the screen locked. WAKE_LOCK is a normal (auto-granted)
         permission. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Nick 2026-10-22 v1.33: in-app auto-updater — the app downloads
         newer APKs and fires the package installer. Android 8+ requires
         this permission; the system prompts the user for the per-app
         "install unknown apps" grant on first use. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Selena Voice"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nick 2026-10-19 v1.16: mediaPlayback type added — the service
             plays Selena's replies with the screen locked (Android 14
             requires the declared type to match the work). -->
        <service
            android:name=".VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- Nick 2026-10-28 v1.51: earbud/headset media-button taps.
             Before v1.51 the app registered NOTHING for media buttons,
             so earbud taps were never delivered to it. This receiver is
             the legacy broadcast path (pattern ported from Siteview's
             EarbudButtonReceiver); the framework MediaSession created in
             VoiceService is the primary path. VoiceService debounces a
             press that arrives via both. -->
        <receiver
            android:name=".EarbudButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Nick 2026-10-22 v1.33: serves the downloaded update APK to the
             package installer. Minimal ContentProvider (no androidx on the
             manual build classpath, so FileProvider isn't available). Only
             serves files from the app's external downloads dir. -->
        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.selena.voice.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
